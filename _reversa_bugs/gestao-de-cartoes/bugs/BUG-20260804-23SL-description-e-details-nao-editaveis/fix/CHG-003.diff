diff --git a/src/webview/theme/dialogs.css b/src/webview/theme/dialogs.css
index ee92aab..af71a3e 100644
--- a/src/webview/theme/dialogs.css
+++ b/src/webview/theme/dialogs.css
@@ -83,7 +83,21 @@
  * stylesheet gives it. The scroller is left alone: the library already gives it
  * the full height, and the floor this sheet declared for it was what made a
  * field ignore the size it was asked for.
+ *
+ * The width is here for the same reason as the height and was missing for a
+ * worse one. That wrapper is a FLEX container, so the editor inside it is a
+ * flex item, and a flex item with no width of its own is sized by its content.
+ * Text hid that: an editor with a line in it stretches and looks right. An
+ * EMPTY field has no content to stretch it, and the editor collapsed to the
+ * gutter of line numbers -- thirty-eight pixels, of which eight were the area
+ * where one writes -- so the click landed beside the editor rather than inside
+ * it and neither field of the card form could be typed into at all
+ * (BUG-20260804-23SL). The floor comes off for the same reason it came off the
+ * scroller: 'min-width: auto' is the width of the content, and with it a long
+ * line stretches the dialog instead of scrolling inside the editor.
  */
 .vsckb-markdown-editor .CodeMirror {
+    width: 100%;
+    min-width: 0;
     height: calc(var(--vsckb-editor-rows, 5) * 1.5em + 16px);
 }
