// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            // Compilacao completa: extensao, recursos e o pacote do Webview.
            // 'watch' sozinho nao copia 'out/res' nem empacota 'src/webview',
            // e o quadro abre em branco.
            "type": "npm",
            "script": "build",
            "problemMatcher": "$tsc",
            "group": "build"
        },
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}