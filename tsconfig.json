{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2019",
        "outDir": "out",
        "lib": [
            "es2019"
        ],
        /* Only these ambient type packages are loaded, so that stray
           'node_modules/@types' folders above the project cannot leak in. */
        "types": [
            "mocha",
            "node"
        ],
        "sourceMap": true,
        "rootDir": "src",
        /* Declaration files of dependencies are not type checked: some of them
           require newer '@types/node' than the one this project is pinned to.
           Code under 'src' is still checked normally. */
        "skipLibCheck": true,
        /* Strict Type-Checking Option */
        "strict": false,   /* enable all strict type-checking options */
        /* Additional Checks */
        "noUnusedLocals": false /* Report errors on unused locals. */
        // "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
        // "noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
        // "noUnusedParameters": true,  /* Report errors on unused parameters. */
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        /* The Webview has its own compilation unit: 'tsconfig.webview.json'.
           It targets a browser and is type checked strictly, which this
           project cannot be yet. */
        "src/webview"
    ]
}